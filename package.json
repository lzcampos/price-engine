    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8"
  }
}
