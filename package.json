{
  "name": "price-engine",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc && node scripts/copy-migrations.mjs",
    "start": "node dist/app.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:push": "drizzle-kit push",
    "seed": "tsx scripts/seed.ts",
    "docker:up": "docker compose --env-file .env up --build -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "dev:worker": "wrangler dev --port 4000",
    "deploy:worker": "wrangler deploy",
    "d1:create": "wrangler d1 create price-engine-db",
    "d1:migrate:local": "wrangler d1 migrations apply price-engine-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply price-engine-db --remote"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^5.2.1",
    "@libsql/client": "^0.14.0",
    "drizzle-orm": "^0.38.3",
    "fastify": "^5.2.1",
    "hono": "^4.6.14",
    "typescript": "^5.7.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "vitest": "^2.1.8",
    "wrangler": "^3.99.0"
  }
}
